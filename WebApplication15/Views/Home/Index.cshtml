@model IEnumerable<WebApplication15.Models.Movie>

@{
    ViewData["Title"] = "Головна";
}

<div class="container my-4">
    <h1 class="mb-4 text-center">🎬 Топ фільмів</h1>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var movie in Model)
            {
                <div class="col">
                    <div class="card h-100">
                        <img src="@movie.PosterUrl" class="card-img-top" alt="@movie.Title">
                        <div class="card-body">
                            <h5 class="card-title">@movie.Title (@movie.ReleaseYear)</h5>
                            <p class="card-text"><strong>Режисер:</strong> @movie.Director</p>
                            <p class="card-text"><strong>Жанр:</strong> @movie.Genre</p>
                            <p class="card-text">@movie.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            Фільми не знайдені або список порожній.
        </div>
    }
</div>