@model IEnumerable<MovieCatalog.Models.Movie>

@{
    ViewData["Title"] = "Топ фільмів";
}

<div class="text-center my-4">
    <h1 class="display-4 fw-bold text-primary">🎬 Топ фільмів за версією редакції</h1>
    <p class="lead text-muted">Найкращі кінострічки, які варто переглянути кожному</p>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var movie in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 movie-card">
                <div class="poster-wrapper">
                    <img src="@movie.PosterUrl" class="card-img-top movie-poster" alt="@movie.Title">
                    <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 fs-6 font-monospace shadow">
                        @movie.ReleaseYear
                    </span>
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold text-dark">@movie.Title</h5>
                    <h6 class="card-subtitle mb-2 text-muted">
                        <i class="bi bi-film"></i> <strong>Жанр:</strong> @movie.Genre
                    </h6>
                    <p class="card-text text-secondary mb-3">
                        <strong>Режисер:</strong> @movie.Director
                    </p>
                    <p class="card-text text-truncate-custom flex-grow-1">
                        @movie.Description
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <button class="btn btn-outline-primary w-100 rounded-pill">Детальніше</button>
                </div>
            </div>
        </div>
    }
</div>