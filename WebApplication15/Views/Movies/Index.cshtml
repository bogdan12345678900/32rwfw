@model IEnumerable<WebApplication15.Models.Movie>

@{
    ViewData["Title"] = "Список фільмів";
}

<div class="d-flex justify-content-between align-items-center my-4">
    <h1 class="fw-bold">🎬 Топ фільмів</h1>
    <a asp-action="Create" class="btn btn-success rounded-pill px-4">+ Додати фільм</a>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var movie in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <img src="@movie.PosterUrl" class="card-img-top" alt="@movie.Title" style="height: 380px; object-fit: cover;">
                <div class="card-body flex-grow-1">
                    <h5 class="card-title fw-bold">@movie.Title (@movie.ReleaseYear)</h5>
                    <p class="card-text text-muted mb-1"><strong>Режисер:</strong> @movie.Director</p>
                    <p class="card-text text-muted"><strong>Жанр:</strong> @movie.Genre</p>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between pb-3">
                    <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-outline-warning btn-sm">Редагувати</a>
                    <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-outline-danger btn-sm">Видалити</a>
                </div>
            </div>
        </div>
    }
</div>